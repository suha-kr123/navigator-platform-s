<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1762956449000_64" author="system" context="default">

        <createTable tableName="n_call_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="identifier" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="provider" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="provider_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="caller_id" type="VARCHAR(255)"/>
            <column name="from_number" type="VARCHAR(50)"/>
            <column name="to_number" type="VARCHAR(50)"/>

            <column name="direction" type="VARCHAR(50)"/>
            <column name="source" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(50)"/>

            <column name="recording_details" type="JSONB"/>
            <column name="completion_details" type="JSONB"/>

            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
