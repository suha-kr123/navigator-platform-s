<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Include all table creation changesets for rolemanagement module -->
    <includeAll path="classpath:db/changelog/rolemanagement/tables"/>
    
    <!-- Include all permission inserts -->
    <includeAll path="classpath:db/changelog/rolemanagement/permissions"/>
    
    <!-- Include all permission group inserts -->
    <includeAll path="classpath:db/changelog/rolemanagement/groups"/>

</databaseChangeLog>

