<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1766993185000_78" author="system" context="default">
        <comment>Map MASTER module permissions to permission groups</comment>
        
        <!-- MASTER_FULL_ACCESS: All MASTER permissions -->
        <insert tableName="n_permission_group_mapping">
            <column name="permission_id" valueComputed="(SELECT id FROM n_permissions WHERE name = 'READ_MASTER_CODE')"/>
            <column name="permission_group_id" valueComputed="(SELECT id FROM n_permission_group WHERE name = 'MASTER_FULL_ACCESS')"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        
        <insert tableName="n_permission_group_mapping">
            <column name="permission_id" valueComputed="(SELECT id FROM n_permissions WHERE name = 'READ_MASTER_LOCATION')"/>
            <column name="permission_group_id" valueComputed="(SELECT id FROM n_permission_group WHERE name = 'MASTER_FULL_ACCESS')"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        
        <insert tableName="n_permission_group_mapping">
            <column name="permission_id" valueComputed="(SELECT id FROM n_permissions WHERE name = 'READ_MASTER_PINCODES')"/>
            <column name="permission_group_id" valueComputed="(SELECT id FROM n_permission_group WHERE name = 'MASTER_FULL_ACCESS')"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        
        <insert tableName="n_permission_group_mapping">
            <column name="permission_id" valueComputed="(SELECT id FROM n_permissions WHERE name = 'READ_MASTER_PRODUCTS')"/>
            <column name="permission_group_id" valueComputed="(SELECT id FROM n_permission_group WHERE name = 'MASTER_FULL_ACCESS')"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        
    </changeSet>

</databaseChangeLog>
