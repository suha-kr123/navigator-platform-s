<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1760000000000_21" author="system" context="default">
        <!-- Create n_roles table -->
        <createTable tableName="n_roles">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>

        <!-- Create n_permissions table -->
        <createTable tableName="n_permissions">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="action" type="varchar(40)"/>
            <column name="operation" type="varchar(40)"/>
            <column name="module" type="varchar(40)"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>

        <!-- Create n_permission_group table -->
        <createTable tableName="n_permission_group">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>

        <!-- Create n_permission_group_mapping table -->
        <createTable tableName="n_permission_group_mapping">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="permission_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="permission_group_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>
        
        <!-- Add unique constraint for n_permission_group_mapping -->
        <addUniqueConstraint
                tableName="n_permission_group_mapping"
                columnNames="permission_id, permission_group_id"
                constraintName="uk_n_permission_group_mapping_permission_group"/>

        <!-- Create n_role_permission_group_mapping table -->
        <createTable tableName="n_role_permission_group_mapping">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="permission_group_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>

        <!-- Create n_role_permission_mapping table -->
        <createTable tableName="n_role_permission_mapping">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="permission_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>

        <!-- Create n_user_role_mapping table -->
        <createTable tableName="n_user_role_mapping">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>
        
        <!-- Add unique constraint for n_user_role_mapping -->
        <addUniqueConstraint
                tableName="n_user_role_mapping"
                columnNames="username, role"
                constraintName="uk_n_user_role_mapping_username_role"/>

        <!-- Add foreign key constraints -->
        <addForeignKeyConstraint
                baseTableName="n_permission_group_mapping"
                baseColumnNames="permission_id"
                constraintName="fk_n_permission_group_mapping_permission"
                referencedTableName="n_permissions"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="n_permission_group_mapping"
                baseColumnNames="permission_group_id"
                constraintName="fk_n_permission_group_mapping_permission_group"
                referencedTableName="n_permission_group"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="n_role_permission_group_mapping"
                baseColumnNames="permission_group_id"
                constraintName="fk_n_role_permission_group_mapping_permission_group"
                referencedTableName="n_permission_group"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="n_role_permission_mapping"
                baseColumnNames="permission_id"
                constraintName="fk_n_role_permission_mapping_permission"
                referencedTableName="n_permissions"
                referencedColumnNames="id"/>

        <!-- Add unique constraints -->
        <addUniqueConstraint
                tableName="n_role_permission_group_mapping"
                columnNames="role, permission_group_id"
                constraintName="uk_n_role_permission_group_mapping_role_group"/>

        <addUniqueConstraint
                tableName="n_role_permission_mapping"
                columnNames="role, permission_id"
                constraintName="uk_n_role_permission_mapping_role_permission"/>

        <!-- Create indexes -->
        <createIndex tableName="n_role_permission_group_mapping" indexName="idx_n_role_permission_group_mapping_role">
            <column name="role"/>
        </createIndex>

        <createIndex tableName="n_role_permission_group_mapping" indexName="idx_n_role_permission_group_mapping_group_id">
            <column name="permission_group_id"/>
        </createIndex>

        <createIndex tableName="n_role_permission_mapping" indexName="idx_n_role_permission_mapping_role">
            <column name="role"/>
        </createIndex>

        <createIndex tableName="n_role_permission_mapping" indexName="idx_n_role_permission_mapping_permission_id">
            <column name="permission_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

