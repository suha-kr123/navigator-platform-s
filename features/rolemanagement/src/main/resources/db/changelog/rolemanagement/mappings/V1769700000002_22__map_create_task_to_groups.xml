<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1769700000002_22" author="system" context="default">
        <comment>Map CREATE_TASK to LEAD_TASKS_FULL_ACCESS (same as READ_TASK, UPDATE_TASK)</comment>
        <insert tableName="n_permission_group_mapping">
            <column name="permission_id" valueComputed="(SELECT id FROM n_permissions WHERE name = 'CREATE_TASK')"/>
            <column name="permission_group_id" valueComputed="(SELECT id FROM n_permission_group WHERE name = 'LEAD_TASKS_FULL_ACCESS')"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
    </changeSet>

</databaseChangeLog>
