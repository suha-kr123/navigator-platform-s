<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1766993185010_88" author="system" context="default">
        <comment>Insert dashboard permissions for LEAD and ADVISOR modules</comment>
        
        <!-- Read Lead Dashboard permission -->
        <insert tableName="n_permissions">
            <column name="name" value="READ_LEAD_DASHBOARD"/>
            <column name="action" value="READ"/>
            <column name="module" value="LEAD"/>
            <column name="operation" value="READ_LEAD"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        
        <!-- Read Advisor Dashboard permission -->
        <insert tableName="n_permissions">
            <column name="name" value="READ_ADVISOR_DASHBOARD"/>
            <column name="action" value="READ"/>
            <column name="module" value="ADVISOR"/>
            <column name="operation" value="READ_ADVISOR"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        
    </changeSet>

</databaseChangeLog>

