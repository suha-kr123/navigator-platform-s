<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1766993185007_87" author="system" context="default">
        <comment>Map LEAD detail update permissions to LEAD_FULL_ACCESS permission group</comment>

        <!-- Map UPDATE_LEAD_PROPOSED_DETAILS to LEAD_FULL_ACCESS -->
        <insert tableName="n_permission_group_mapping">
            <column name="permission_id" valueComputed="(SELECT id FROM n_permissions WHERE name = 'UPDATE_LEAD_PROPOSED_DETAILS')"/>
            <column name="permission_group_id" valueComputed="(SELECT id FROM n_permission_group WHERE name = 'LEAD_FULL_ACCESS')"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        
        <!-- Map UPDATE_LEAD_PROPERTY_DETAILS to LEAD_FULL_ACCESS -->
        <insert tableName="n_permission_group_mapping">
            <column name="permission_id" valueComputed="(SELECT id FROM n_permissions WHERE name = 'UPDATE_LEAD_PROPERTY_DETAILS')"/>
            <column name="permission_group_id" valueComputed="(SELECT id FROM n_permission_group WHERE name = 'LEAD_FULL_ACCESS')"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        
        <!-- Map UPDATE_LEAD_SOURCING_DETAILS to LEAD_FULL_ACCESS -->
        <insert tableName="n_permission_group_mapping">
            <column name="permission_id" valueComputed="(SELECT id FROM n_permissions WHERE name = 'UPDATE_LEAD_SOURCING_DETAILS')"/>
            <column name="permission_group_id" valueComputed="(SELECT id FROM n_permission_group WHERE name = 'LEAD_FULL_ACCESS')"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        
    </changeSet>

</databaseChangeLog>

