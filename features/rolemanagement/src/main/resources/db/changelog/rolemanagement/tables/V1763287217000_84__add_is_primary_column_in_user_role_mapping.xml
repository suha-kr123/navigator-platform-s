<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1763287217000_38" author="system" context="default">
        
        <!-- Add is_primary column to n_user_role_mapping table -->
        <addColumn tableName="n_user_role_mapping">
            <column name="is_primary" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        
        <!-- Create partial unique index to ensure only one primary role per username -->
        <sql>
            CREATE UNIQUE INDEX IF NOT EXISTS uk_n_user_role_mapping_username_primary
                ON n_user_role_mapping (username)
                WHERE is_primary = true;
        </sql>
        
    </changeSet>

</databaseChangeLog>
