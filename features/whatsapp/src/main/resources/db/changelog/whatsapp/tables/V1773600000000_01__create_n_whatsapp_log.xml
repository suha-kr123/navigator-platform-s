<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1773600000000_01_create_n_whatsapp_log" author="navigator" context="default">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="n_whatsapp_log"/>
            </not>
        </preConditions>
        <comment>Create n_whatsapp_log to persist inbound/outbound WhatsApp messages from provider webhooks.</comment>
        <createTable tableName="n_whatsapp_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="identifier" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="provider" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="provider_message_id" type="VARCHAR(255)"/>
            <column name="provider_conversation_id" type="VARCHAR(255)"/>
            <column name="sent_by" type="VARCHAR(50)"/>

            <column name="phone" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="from_channel_id" type="VARCHAR(100)"/>

            <column name="status" type="VARCHAR(50)"/>
            <column name="message_type" type="VARCHAR(50)"/>

            <column name="message_data" type="JSONB"/>
            <column name="template_details" type="JSONB"/>

            <column name="created_source" type="VARCHAR(50)"/>

            <column name="message_time" type="TIMESTAMP WITH TIME ZONE"/>

            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>

        <createIndex indexName="idx_n_whatsapp_log_provider_message_id" tableName="n_whatsapp_log">
            <column name="provider_message_id"/>
        </createIndex>
        <createIndex indexName="idx_n_whatsapp_log_provider_conversation_id" tableName="n_whatsapp_log">
            <column name="provider_conversation_id"/>
        </createIndex>
        <createIndex indexName="idx_n_whatsapp_log_phone" tableName="n_whatsapp_log">
            <column name="phone"/>
        </createIndex>
        <createIndex indexName="idx_n_whatsapp_log_from_channel_id" tableName="n_whatsapp_log">
            <column name="from_channel_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="n_whatsapp_log"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
