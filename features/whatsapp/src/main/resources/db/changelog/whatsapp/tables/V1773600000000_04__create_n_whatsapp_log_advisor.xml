<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1773600000000_04_create_n_whatsapp_log_advisor" author="navigator" context="default">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="n_whatsapp_log_advisor"/>
            </not>
        </preConditions>
        <comment>Mapping table: one advisor per whatsapp log (PK whatsapp_log_id); AuditableEntity columns. No FK constraints.</comment>
        <createTable tableName="n_whatsapp_log_advisor">
            <column name="whatsapp_log_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_n_whatsapp_log_advisor"/>
            </column>
            <column name="advisor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_n_whatsapp_log_advisor_advisor_id" tableName="n_whatsapp_log_advisor">
            <column name="advisor_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="n_whatsapp_log_advisor"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
