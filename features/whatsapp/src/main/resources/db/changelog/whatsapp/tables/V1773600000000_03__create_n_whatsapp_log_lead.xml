<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1773600000000_03_create_n_whatsapp_log_lead" author="navigator" context="default">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="n_whatsapp_log_lead"/>
            </not>
        </preConditions>
        <comment>Mapping table: one lead per whatsapp log (PK whatsapp_log_id); AuditableEntity columns. No FK constraints.</comment>
        <createTable tableName="n_whatsapp_log_lead">
            <column name="whatsapp_log_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_n_whatsapp_log_lead"/>
            </column>
            <column name="lead_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="contact_id" type="BIGINT"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_n_whatsapp_log_lead_lead_id" tableName="n_whatsapp_log_lead">
            <column name="lead_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="n_whatsapp_log_lead"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
