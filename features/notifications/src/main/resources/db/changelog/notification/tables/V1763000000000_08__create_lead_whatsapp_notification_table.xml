<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1763000000000_08" author="system">
        <createTable tableName="n_lead_whatsapp_notification">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lead_identifier" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="receipt_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="notification_record_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="template_id" type="VARCHAR(255)"/>
            <column name="template_name" type="VARCHAR(255)"/>
            <column name="local_message_id" type="VARCHAR(255)"/>
            <column name="whatsapp_message_id" type="VARCHAR(500)"/>
            <column name="wa_id" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(50)" defaultValue="SENT">
                <constraints nullable="false"/>
            </column>
            <column name="is_replied" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="reply_text" type="TEXT"/>
            <column name="reply_timestamp" type="TIMESTAMP"/>
            <column name="delivered_timestamp" type="TIMESTAMP"/>
            <column name="sent_timestamp" type="TIMESTAMP"/>
            <column name="conversation_id" type="VARCHAR(255)"/>
            <column name="ticket_id" type="VARCHAR(255)"/>
            <column name="error_message" type="TEXT"/>
            <column name="is_valid_whatsapp_number" type="BOOLEAN"/>
            <column name="created_by" type="VARCHAR(255)" defaultValue="system"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="version" type="INT" defaultValueNumeric="1"/>
        </createTable>
        
        <addForeignKeyConstraint
                baseTableName="n_lead_whatsapp_notification"
                baseColumnNames="receipt_id"
                referencedTableName="n_notification_receipt"
                referencedColumnNames="id"
                constraintName="fk_lead_whatsapp_receipt"
                onDelete="CASCADE"/>
        
        <addForeignKeyConstraint
                baseTableName="n_lead_whatsapp_notification"
                baseColumnNames="notification_record_id"
                referencedTableName="n_notification_record"
                referencedColumnNames="id"
                constraintName="fk_lead_whatsapp_record"
                onDelete="CASCADE"/>
        
        <createIndex tableName="n_lead_whatsapp_notification" indexName="idx_lead_whatsapp_lead_identifier">
            <column name="lead_identifier"/>
        </createIndex>
        
        <createIndex tableName="n_lead_whatsapp_notification" indexName="idx_lead_whatsapp_local_message_id">
            <column name="local_message_id"/>
        </createIndex>
        
        <createIndex tableName="n_lead_whatsapp_notification" indexName="idx_lead_whatsapp_whatsapp_message_id">
            <column name="whatsapp_message_id"/>
        </createIndex>
        
        <createIndex tableName="n_lead_whatsapp_notification" indexName="idx_lead_whatsapp_receipt_id">
            <column name="receipt_id"/>
        </createIndex>
        
        <createIndex tableName="n_lead_whatsapp_notification" indexName="idx_lead_whatsapp_status">
            <column name="status"/>
        </createIndex>
        
        <rollback>
            <dropTable tableName="n_lead_whatsapp_notification"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

