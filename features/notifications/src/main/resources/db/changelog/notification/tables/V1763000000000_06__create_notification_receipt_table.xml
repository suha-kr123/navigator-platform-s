<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1763000000000_06" author="system">
        <createTable tableName="n_notification_receipt">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="notification_record_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="mode" type="VARCHAR(50)"/>
            <column name="recipient_contact" type="VARCHAR(255)"/>
            <column name="channel_type" type="VARCHAR(50)"/>
            <column name="template_identifier" type="VARCHAR(255)"/>
            <column name="message_payload" type="JSONB"/>
            <column name="status" type="VARCHAR(50)" defaultValue="INITIATED">
                <constraints nullable="false"/>
            </column>
            <column name="details" type="JSONB"/>
            <column name="schedules" type="JSONB"/>
            <column name="remarks" type="JSONB"/>
            <column name="created_by" type="VARCHAR(255)" defaultValue="system"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="version" type="INT" defaultValueNumeric="1"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="n_notification_receipt"
                baseColumnNames="notification_record_id"
                referencedTableName="n_notification_record"
                referencedColumnNames="id"
                constraintName="fk_receipt_record"
                onDelete="CASCADE"/>
        <createIndex tableName="n_notification_receipt" indexName="idx_notification_receipt_status">
            <column name="status"/>
        </createIndex>
        <rollback>
            <dropTable tableName="n_notification_receipt"/>
        </rollback>
    </changeSet>

</databaseChangeLog>


