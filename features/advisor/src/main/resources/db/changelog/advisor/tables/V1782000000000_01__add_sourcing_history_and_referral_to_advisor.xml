<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1782000000000_01_advisor" author="system" context="default">

        <addColumn tableName="n_advisor">
            <column name="sourcing_history" type="JSONB" defaultValue="[]">
                <constraints nullable="false"/>
            </column>
            <column name="referred_by_code" type="VARCHAR(100)"/>
            <column name="referred_by_type" type="VARCHAR(50)"/>
            <column name="referred_by_identifier" type="UUID"/>
        </addColumn>

    </changeSet>

</databaseChangeLog>
