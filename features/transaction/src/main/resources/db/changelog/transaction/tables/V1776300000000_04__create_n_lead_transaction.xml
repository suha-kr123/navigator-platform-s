<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1776300000000_04__create_n_lead_transaction" author="system">
        <createTable tableName="n_lead_transaction">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identifier" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="lead_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="domain_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="referral_code" type="VARCHAR(100)"/>
            <column name="created_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_n_lead_transaction_lead_id" tableName="n_lead_transaction">
            <column name="lead_id"/>
        </createIndex>
        <createIndex indexName="idx_n_lead_transaction_txn_id" tableName="n_lead_transaction">
            <column name="transaction_id"/>
        </createIndex>
        <createIndex indexName="idx_n_lead_transaction_domain_type" tableName="n_lead_transaction">
            <column name="domain_type"/>
        </createIndex>
        <createIndex indexName="idx_n_lead_transaction_referral_code" tableName="n_lead_transaction">
            <column name="referral_code"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
