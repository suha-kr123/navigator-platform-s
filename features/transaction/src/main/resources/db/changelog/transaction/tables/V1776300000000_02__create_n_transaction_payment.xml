<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1776300000000_02__create_n_transaction_payment" author="system">
        <createTable tableName="n_transaction_payment">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identifier" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="payment_mode" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="external_reference" type="VARCHAR(100)"/>
            <column name="payment_status" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_date" type="DATE"/>
            <column name="recorded_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_data" type="JSONB"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_n_transaction_payment_txn_id" tableName="n_transaction_payment">
            <column name="transaction_id"/>
        </createIndex>
        <createIndex indexName="idx_n_transaction_payment_status" tableName="n_transaction_payment">
            <column name="payment_status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
