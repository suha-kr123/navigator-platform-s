<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1776300000000_03__create_n_transaction_event" author="system">
        <createTable tableName="n_transaction_event">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identifier" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="actor_username" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="remarks" type="TEXT"/>
            <column name="payment_details" type="JSONB"/>
            <column name="event_timestamp" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_payment_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_n_transaction_event_txn_id" tableName="n_transaction_event">
            <column name="transaction_id"/>
        </createIndex>
        <createIndex indexName="idx_n_transaction_event_type" tableName="n_transaction_event">
            <column name="event_type"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
