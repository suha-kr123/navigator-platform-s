<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1764580641000_00" author="system" context="default">
        <!-- Create n_master_country table -->
        <createTable tableName="n_master_country">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(50)"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>

        <createIndex indexName="idx_country_code" tableName="n_master_country">
            <column name="code"/>
        </createIndex>
        <createIndex indexName="idx_country_is_active" tableName="n_master_country">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

    <changeSet id="V1764580641000_01" author="system" context="default">
        <!-- Create n_master_state table -->
        <createTable tableName="n_master_state">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="country_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(50)"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="n_master_state"
                                 baseColumnNames="country_id"
                                 constraintName="fk_state_country"
                                 referencedTableName="n_master_country"
                                 referencedColumnNames="id"/>

        <createIndex indexName="idx_state_country_id" tableName="n_master_state">
            <column name="country_id"/>
        </createIndex>
        <createIndex indexName="idx_state_code" tableName="n_master_state">
            <column name="code"/>
        </createIndex>
        <createIndex indexName="idx_state_is_active" tableName="n_master_state">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

    <changeSet id="V1764580641000_02" author="system" context="default">
        <!-- Create n_master_district table -->
        <createTable tableName="n_master_district">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="state_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(50)"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="n_master_district"
                                 baseColumnNames="state_id"
                                 constraintName="fk_district_state"
                                 referencedTableName="n_master_state"
                                 referencedColumnNames="id"/>

        <createIndex indexName="idx_district_state_id" tableName="n_master_district">
            <column name="state_id"/>
        </createIndex>
        <createIndex indexName="idx_district_code" tableName="n_master_district">
            <column name="code"/>
        </createIndex>
        <createIndex indexName="idx_district_is_active" tableName="n_master_district">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

    <changeSet id="V1764580641000_03" author="system" context="default">
        <!-- Create n_master_taluka table -->
        <createTable tableName="n_master_taluka">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="district_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(50)"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="n_master_taluka"
                                 baseColumnNames="district_id"
                                 constraintName="fk_taluka_district"
                                 referencedTableName="n_master_district"
                                 referencedColumnNames="id"/>

        <createIndex indexName="idx_taluka_district_id" tableName="n_master_taluka">
            <column name="district_id"/>
        </createIndex>
        <createIndex indexName="idx_taluka_code" tableName="n_master_taluka">
            <column name="code"/>
        </createIndex>
        <createIndex indexName="idx_taluka_is_active" tableName="n_master_taluka">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

    <changeSet id="V1764580641000_04" author="system" context="default">
        <!-- Create n_master_village table -->
        <createTable tableName="n_master_village">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="taluka_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(50)"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="n_master_village"
                                 baseColumnNames="taluka_id"
                                 constraintName="fk_village_taluka"
                                 referencedTableName="n_master_taluka"
                                 referencedColumnNames="id"/>

        <createIndex indexName="idx_village_taluka_id" tableName="n_master_village">
            <column name="taluka_id"/>
        </createIndex>
        <createIndex indexName="idx_village_code" tableName="n_master_village">
            <column name="code"/>
        </createIndex>
        <createIndex indexName="idx_village_is_active" tableName="n_master_village">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

