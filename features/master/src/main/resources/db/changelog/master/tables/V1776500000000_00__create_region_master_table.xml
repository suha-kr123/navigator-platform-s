<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1776500000000_00" author="system" context="default">
        <!-- Create n_master_region table -->
        <createTable tableName="n_master_region">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="state_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(50)"/>
            <column name="name" type="jsonb"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="display_order" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="n_master_region"
                                 baseColumnNames="state_id"
                                 constraintName="fk_region_state"
                                 referencedTableName="n_master_state"
                                 referencedColumnNames="id"/>

        <createIndex indexName="idx_region_state_id" tableName="n_master_region">
            <column name="state_id"/>
        </createIndex>
        <createIndex indexName="idx_region_code" tableName="n_master_region">
            <column name="code"/>
        </createIndex>
        <createIndex indexName="idx_region_is_active" tableName="n_master_region">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
