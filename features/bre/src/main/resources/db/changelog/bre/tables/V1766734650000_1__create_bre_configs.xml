<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1766734650000_1" author="system" context="default">
        <createTable tableName="n_bre_configs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uname" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="config" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)" defaultValue="system"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="updated_by" type="VARCHAR(255)" defaultValue="system"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>

        <createIndex indexName="idx_n_bre_configs_uname" tableName="n_bre_configs">
            <column name="uname"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
