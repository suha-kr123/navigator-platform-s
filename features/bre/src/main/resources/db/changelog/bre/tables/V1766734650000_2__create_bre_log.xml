<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1766734650000_2" author="system" context="default">
        <createTable tableName="n_bre_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(50)"/>
            <column name="entity_id" type="BIGINT"/>
            <column name="config_id" type="BIGINT"/>
            <column name="request" type="TEXT"/>
            <column name="response" type="TEXT"/>
            <column name="created_by" type="VARCHAR(255)" defaultValue="system"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="updated_by" type="VARCHAR(255)" defaultValue="system"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>

        <createIndex indexName="idx_n_bre_log_entity" tableName="n_bre_log">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>

        <createIndex indexName="idx_n_bre_log_config_id" tableName="n_bre_log">
            <column name="config_id"/>
        </createIndex>

        <createIndex indexName="idx_n_bre_log_created_at" tableName="n_bre_log">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
