<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1781000000000_01_otp_core" author="codex">
        <createTable tableName="n_one_time_token">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="otp" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="relates_to" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>

        <createIndex indexName="idx_n_one_time_token_relates_to" tableName="n_one_time_token">
            <column name="relates_to"/>
        </createIndex>

        <createTable tableName="n_otp_configuration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uname" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="config" type="jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)" defaultValue="system"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)" defaultValue="system"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>

        <sql>
            INSERT INTO n_otp_configuration (uname, config, created_by, updated_by)
            VALUES (
                'VERIFY_LEAD_FOR_CB',
                '{
                  "otp_validity_in_mins": 10,
                  "otp_generation_method": "simple_otp_generation",
                  "max_resend_attempts": 5
                }'::jsonb,
                'system',
                'system'
            );
        </sql>
    </changeSet>

</databaseChangeLog>
