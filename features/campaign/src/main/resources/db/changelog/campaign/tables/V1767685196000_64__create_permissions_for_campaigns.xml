    <changeSet id="V1767685196000_18" author="system" context="default">
        <comment>Insert CAMPAIGN module permission groups</comment>
        
        <!-- Insert permission groups -->
        <insert tableName="n_permission_group">
            <column name="name" value="CAMPAIGN_FULL_ACCESS"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        
