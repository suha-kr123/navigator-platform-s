            <column name="name" value="CAMPAIGN_CONFIG_FULL_ACCESS"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        
    </changeSet>

    <changeSet id="V1767685196000_19" author="system" context="default">
        <comment>Map CAMPAIGN module permissions to permission groups</comment>
        
        <!-- CAMPAIGN_FULL_ACCESS: All CAMPAIGN permissions -->
        <insert tableName="n_permission_group_mapping">
            <column name="permission_id" valueComputed="(SELECT id FROM n_permissions WHERE name = 'READ_CAMPAIGN')"/>
            <column name="permission_group_id" valueComputed="(SELECT id FROM n_permission_group WHERE name = 'CAMPAIGN_FULL_ACCESS')"/>
            <column name="created_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
