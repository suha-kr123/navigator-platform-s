<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1766920132000_6" author="system" context="default">

        <createTable tableName="n_campaign">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identifier" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="config_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="VARCHAR(100)"/>
            <column name="provider_id" type="VARCHAR(100)"/>
            <column name="provider_details" type="JSONB"/>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(50)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="document_details" type="JSONB"/> <!--csv document id,  -->
            <column name="summary" type="JSONB"/> <!--report url and summary from campaign-->
            <column name="created_by" type="VARCHAR(255)" defaultValue="system"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="version" type="INT" defaultValueNumeric="1"/>
        </createTable>

        <createIndex indexName="idx_n_campaign_identifier" tableName="n_campaign">
            <column name="identifier"/>
        </createIndex>

        <createIndex indexName="idx_n_campaign_name" tableName="n_campaign">
            <column name="name"/>
        </createIndex>

        <createIndex indexName="idx_n_campaign_status" tableName="n_campaign">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_n_campaign_created_at" tableName="n_campaign">
            <column name="created_at"/>
        </createIndex>

        <createIndex indexName="idx_n_campaign_provider_id" tableName="n_campaign">
            <column name="provider_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
