<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1781000000001_02_lead_otp_tracking" author="codex">
        <createTable tableName="n_lead_one_time_token">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lead_id" type="BIGINT"/>
            <column name="contact_id" type="BIGINT"/>
            <column name="ott_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_lead_otp_ott_id" references="n_one_time_token(id)"/>
            </column>
            <column name="reference" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>

        <createIndex indexName="idx_n_lead_one_time_token_scope" tableName="n_lead_one_time_token">
            <column name="reference"/>
            <column name="lead_id"/>
            <column name="contact_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
