<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1767955006000_62" author="system" context="default">
        <createTable tableName="n_cb_customer_enquiry">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="identifier" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="enquiry_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="lender_name" type="VARCHAR(200)"/>
            <column name="inquiry_date" type="DATE"/>
            <column name="ownership_type" type="VARCHAR(50)"/>
            <column name="credit_inquiry_purpose_type" type="VARCHAR(100)"/>
            <column name="inquiry_amount" type="NUMERIC(18,2)"/>

            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </createTable>
        <createIndex indexName="idx_cb_customer_enquiry_enquiry_date_id" tableName="n_cb_customer_enquiry">
            <column name="enquiry_id"/>
            <column name="inquiry_date"/>
            <column name="id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
