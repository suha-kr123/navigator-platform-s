<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- remove is_primary from address table -->
    <changeSet id="26-remove-is_primary-from-address-table" author="nivasafinance">
        <dropColumn tableName="address" columnName="is_primary" />
    </changeSet>

    <!-- remove verification_status and verification_notes from identifier table -->
    <changeSet id="27-remove-verification_status-and-verification_notes-from-identifier-table" author="nivasafinance">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="identifier" columnName="verification_status"/>
        </preConditions>
        <dropColumn tableName="identifier" columnName="verification_status" />
        <dropColumn tableName="identifier" columnName="verification_notes" />
    </changeSet>

    <!-- remove the whole income_details table -->
    <changeSet id="28-remove-income_details-table" author="nivasafinance">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="income_details"/>
        </preConditions>
        <dropTable tableName="income_details" />
    </changeSet>

    <!-- remove income_detail_ids from lead table -->
    <changeSet id="29-remove-income_detail_ids-from-lead-table" author="nivasafinance">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="lead" columnName="income_detail_ids"/>
        </preConditions>
        <dropColumn tableName="lead" columnName="income_detail_ids" />
    </changeSet>

    <!-- delete lead_persons table -->
    <changeSet id="30-delete-lead_persons-table" author="nivasafinance">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="lead_persons"/>
        </preConditions>
        <dropTable tableName="lead_persons" />
    </changeSet>

    <!-- remove email from person table -->
    <changeSet id="31-remove-email-from-person-table" author="nivasafinance">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="person" columnName="email"/>
        </preConditions>
        <dropColumn tableName="person" columnName="email" />
    </changeSet>

