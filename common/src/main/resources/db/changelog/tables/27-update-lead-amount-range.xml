<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Update leads table to use amount range instead of single amount -->
    <changeSet id="update-lead-amount-range" author="nivasafinance">
        <!-- Change the column type from numeric to jsonb -->
        <sql>
            ALTER TABLE leads 
            ALTER COLUMN requested_amount TYPE jsonb 
            USING jsonb_build_object('min', requested_amount, 'max', requested_amount);
        </sql>
    </changeSet>

</databaseChangeLog>
