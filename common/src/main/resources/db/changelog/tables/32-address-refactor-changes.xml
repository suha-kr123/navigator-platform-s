<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Rename address_ids to address_id in leads table -->
    <changeSet id="32-rename-address-ids-to-address-id" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="leads" columnName="address_ids"/>
        </preConditions>
        <renameColumn tableName="leads" 
                      oldColumnName="address_ids" 
                      newColumnName="address_id" 
                      columnDataType="uuid"/>
    </changeSet>

    <!-- Remove nullable constraint from address_type in address table -->
    <changeSet id="32-remove-address-type-nullable-constraint" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="address" columnName="address_type"/>
        </preConditions>
        <dropNotNullConstraint tableName="address" columnName="address_type"/>
    </changeSet>

    <!-- Remove nullable constraint from address_source in address table -->
    <changeSet id="32-remove-address-source-nullable-constraint" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="address" columnName="address_source"/>
        </preConditions>
        <dropNotNullConstraint tableName="address" columnName="address_source"/>
    </changeSet>

</databaseChangeLog>
