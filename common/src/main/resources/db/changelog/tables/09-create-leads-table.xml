<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-leads-table" author="system">
        <createTable tableName="leads">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="requested_amount" type="numeric">
                <constraints nullable="false"/>
            </column>
            <column name="purpose" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="product_code" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="pipeline_key" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="current_stage" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="sourcing_channel" type="varchar(255)"/>
            <column name="preliminary_information" type="jsonb"/>
            <column name="ext_data" type="jsonb"/>
            <column name="task_data" type="jsonb"/>
            <column name="address_ids" type="jsonb"/>
            <column name="identifier_ids" type="jsonb"/>
            <column name="document_ids" type="jsonb"/>
            <column name="income_detail_ids" type="jsonb"/>
            <column name="note_ids" type="jsonb"/>
            <column name="stage_ids" type="jsonb"/>
            <column name="person_data" type="jsonb"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp"/>
            <column name="version" type="bigint"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
