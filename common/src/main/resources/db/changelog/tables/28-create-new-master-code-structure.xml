<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="delete-old-code-master-table" author="system">
        <dropTable tableName="code_master"/>
    </changeSet>

    <changeSet id="create-master-code-table" author="system">
        <createTable tableName="master_code">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="parent_id" type="uuid"/>
            <column name="key" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="jsonb"/>
            <column name="description" type="jsonb"/>
            <column name="is_system_defined" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp"/>
            <column name="version" type="bigint"/>
        </createTable>
    </changeSet>

    <changeSet id="create-master-code-value-table" author="system">
        <createTable tableName="master_code_value">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="code_key" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="jsonb"/>
            <column name="description" type="jsonb"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="timestamp"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_at" type="timestamp"/>
            <column name="version" type="bigint"/>
        </createTable>
    </changeSet>

