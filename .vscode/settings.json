{
  "java.compile.nullAnalysis.mode": "automatic",
  "java.debug.settings.onBuildFailureProceed": true,
  "java.configuration.updateBuildConfiguration": "interactive",
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "debug.console.fontSize": 14,
  "debug.focusWindowOnBreak": false,
  "debug.showInStatusBar": "always",
  "workbench.editor.showTabs": "multiple",
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Tomorrow Night Bright",
  "workbench.iconTheme": "material-icon-theme",
  "editor.fontFamily": "'SF Mono', Monaco, 'Cascadia Code', 'Courier New', monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.5,
  "editor.minimap.enabled": true,
  "editor.wordWrap": "off",
  "editor.formatOnSave": false,
  "editor.tabSize": 4,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontFamily": "'SF Mono', Monaco, 'Cascadia Code', 'Courier New', monospace",
  "workbench.tree.indent": 8,
  "explorer.compactFolders": false,
  "workbench.editor.openPositioning": "right",
  "explorer.fileNesting.enabled": true,
  "workbench.activityBar.iconClickBehavior": "toggle",
  "workbench.sideBar.visible": true,
  "workbench.statusBar.visible": true,
  "workbench.menuBar.visibility": "default",
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms100m -Xlog:disable"
}