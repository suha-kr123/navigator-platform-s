<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="V1763020529000_23" author="system" context="default">
        <createTable tableName="n_third_party_response_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="BIGINT"/>
            <column name="request_method" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="request" type="text"/>
            <column name="response" type="text"/>
            <column name="http_status_code" type="INTEGER"/>
            <column name="response_time_ms" type="BIGINT"/>
            <column name="provider_name" type="VARCHAR(50)"/>
            <column name="provider_ref_id" type="VARCHAR(50)"/>
            <column name="business_purpose" type="VARCHAR(255)"/>

            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
